# Optional overrides. For the local demo none are needed: the server reads the
# credentials file that `npm run demo:setup` (junctura-health) wrote for this app.
# Real environment variables win over that file. Never commit a real .env.

# Where the junctura-health checkout lives (demo accounts and credentials).
# JUNCTURA_HEALTH_DIR=../junctura-health

# Use another credentials file instead of <JUNCTURA_HEALTH_DIR>/.junctura/demo/junctura-insurance.env
# JUNCTURA_INSURANCE_ENV=

# Public values of the Junctura identity provider and this app's browser (PKCE) client.
# JUNCTURA_ISSUER=http://localhost:8080/identity/realms/junctura
# JUNCTURA_WEB_CLIENT_ID=health-insurance-web

# Server-side client that calls Junctura capabilities (claim-verify and the
# call log, check and decision records). All three must be set to enable those calls; keep the secret off the
# browser. For Docker, pass them with --env-file instead of baking them into the image.
# JUNCTURA_URL=http://localhost:8080
# JUNCTURA_APP_CLIENT_ID=health-insurance
# JUNCTURA_APP_CLIENT_SECRET=

# Listening address. The default port 5185 is the one registered for the browser client.
# PORT=5185
# HOST=127.0.0.1

# Days allowed to handle a claim, counted from its submission date (1 to 365).
# INSURANCE_SLA_DAYS=30

# Built web UI directory.
# INSURANCE_STATIC_DIR=web/dist
